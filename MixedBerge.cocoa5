------------------------------------------------------------------------------
-- Main code to compute completely Mixed Berge equilibria for N-player games
-- N=number of players
-- D=[d_1,..,d_N] vector of number of strategies (minus 1)
-- ValuesU = vector of payoff functions
------------------------------------------------------------------------------
Define MixedBerge(N,D,ValuesU)
  MixedBerge:=[];
  ListD:=[0..D[I]|I In 1..N];
  ProdD:=CartesianProductList(ListD);
  
  For I:=1 To N Do
    ProdDI:=CartesianProductList(WithoutNth(ListD,I));
    --construct the variables Z
    Z:=[];
    Seq0:=[0|El In 1..N-1];
    For J:=0 To D[I] Do
      Seq:=Seq0;
      ZJ:=[];
      If I<N Then
	insert(ref Seq,I,J);
      Else
	append(ref Seq,J);
      EndIf;
      Pos:=1;
      While (not(ProdD[Pos]=Seq)) Do
	  Pos:=Pos+1;
      EndWhile;
      Ui0:=ValuesU[I,Pos];
      Foreach K In ProdDI Do
	If not(K=Seq0) Then
	  Seq2:=K;
	  If I<N Then
	    insert(ref Seq2,I,J);
	  Else
	    append(ref Seq2,J);
	  EndIf;
	  Pos:=1;
	  While (not(ProdD[Pos]=Seq2)) Do
	    Pos:=Pos+1;
	  EndWhile;
	  append(ref ZJ,ValuesU[I,Pos]-Ui0);
	EndIf;
      EndForeach;
      append(ref Z,ZJ);	
    EndFor;

    --construct the matrix Ai
    Ai:=Mat(Z);
    Ai:=transposed(Ai);
    Ai:=ConcatVer(Ai,Mat([[1|KK In 0..D[I]]]));
    --PrintLn "Ai", Ai;PrintLn;

    --construct the column vector Bi
    V:=[0|KK In 1..NumRows(Ai)-1];
    append(ref V,1);
    Bi:=Mat([V]);
    Bi:=transposed(Bi);

    --construct the matrix (Ai|bi)
    AiBi:=ConcatHor(Ai,Bi);

    --compute the rank of the matrices Ai and (Ai|bi) 
    rankAi:=rk(Ai);
    rankAiBi:=rk(AiBi);

    If Not(rankAi=rankAiBi) Then
      SolI:=[];
      --println "no mixed Berge strategies";
      break;
    Else
      --PrintLn "Rank Ai = ", rankAi; 
      If rankAi<D[I]+1 Then
	SolI:=[];
	println "the game is not regular";
	break;
      Else
	--compute solutions
	SolI:=transposed(LinSolve(Ai,Bi));
	SolI:=GetRow(SolI,1);
	--accept only positive solutions
	If min(SolI)<0 Then
	  SolI:=[];
	EndIf;
      EndIf;
    EndIf;

    If Not(SolI=[]) Then
      append(ref MixedBerge, SolI);
    EndIf;
  EndFor;
  

  If SolI=[] Then
    return [];
  Else
    return flatten(MixedBerge);
  EndIf;
EndDefine; -- MixedBerge
